# LLM backend: 'ollama' (local, default) or 'gemini' (cloud — no Ollama needed)
LLM_PROVIDER=ollama

# --- Local Ollama (default) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4

# --- Google Gemini cloud option ---
# To use the cloud brain instead of local Ollama:
#   1. Get a free key at https://aistudio.google.com/apikey
#   2. Set LLM_PROVIDER=gemini at the top
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Google Places API key (OPTIONAL — app works without it via free OpenStreetMap).
# Get a free key: https://console.cloud.google.com → APIs & Services →
# enable "Places API (New)" → Credentials → Create API key
GOOGLE_PLACES_API_KEY=
